---
import SectionMarker from './SectionMarker.astro';
---

<section id="final-cta" class="final-cta" aria-labelledby="final-cta-heading">
	<div class="container final-cta-inner">
		<SectionMarker number="08" label="Let's Build It" />
		<h2 id="final-cta-heading">YOUR TEAM.<br />YOUR IDENTITY.<br />LET'S BUILD IT.</h2>
		<p class="final-cta-sub">Tell us what your team stands for.</p>
		<a class="btn" href="https://wa.me/628977200741">
			Start a Project
			<span class="btn-arrow" aria-hidden="true">→</span>
		</a>
	</div>
</section>

<style>
	.final-cta {
		padding-block: calc(var(--chapter-gap) / 2) var(--chapter-gap);
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}

	.final-cta-inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.75rem;
	}

	.final-cta-inner h2 {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5.1vw, 5rem);
		font-weight: 650;
		line-height: 1.04;
		letter-spacing: var(--tracking-display);
	}

	.final-cta-sub {
		font-size: 1rem;
		color: var(--color-ink-muted);
	}

	@media (max-width: 599px) {
		.final-cta-inner h2 {
			font-size: clamp(2rem, 8.5vw, 3rem);
		}
	}
</style>
