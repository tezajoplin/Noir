---
import Wordmark from '../assets/noir-wordmark.svg';
import { langFromUrl, lp } from '../i18n';

const lang = langFromUrl(Astro.url);
const copy = {
	id: {
		home: 'NOIR — beranda',
		tagline: 'We build team identities, not just jerseys.',
		products: 'Produk',
		more: 'Olahraga lainnya',
		company: 'Perusahaan',
		teams: 'Tim Kami',
		how: 'Cara Kerja',
		about: 'Tentang',
		contact: 'Kontak',
		quote: 'Minta Penawaran',
		rights: 'Hak cipta dilindungi.',
	},
	en: {
		home: 'NOIR — home',
		tagline: 'We build team identities, not just jerseys.',
		products: 'Products',
		more: 'More sports',
		company: 'Company',
		teams: 'Our Teams',
		how: 'How It Works',
		about: 'About',
		contact: 'Contact',
		quote: 'Get a Quote',
		rights: 'All rights reserved.',
	},
}[lang];

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-top">
		<div class="footer-brand">
			<a href={lp(lang, '/')} class="wordmark" aria-label={copy.home}><Wordmark aria-hidden="true" /></a>
			<p>{copy.tagline}</p>
		</div>

		<nav aria-label={copy.products}>
			<p class="footer-col-title">{copy.products}</p>
			<ul>
				<li><a href={lp(lang, '/#noir-football')}>Football</a></li>
				<li><a href={lp(lang, '/#noir-futsal')}>Futsal</a></li>
				<li><a href={lp(lang, '/#noir-basketball')}>Basketball</a></li>
				<li><a href={lp(lang, '/#what-we-make')}>{copy.more}</a></li>
			</ul>
		</nav>

		<nav aria-label={copy.company}>
			<p class="footer-col-title">{copy.company}</p>
			<ul>
				<li><a href={lp(lang, '/#built')}>{copy.teams}</a></li>
				<li><a href={lp(lang, '/#how-it-works')}>{copy.how}</a></li>
				<li><a href={lp(lang, '/about/')}>{copy.about}</a></li>
			</ul>
		</nav>

		<nav aria-label={copy.contact}>
			<p class="footer-col-title">{copy.contact}</p>
			<ul>
				<li><a href={lp(lang, '/get-a-quote/')}>{copy.quote}</a></li>
				<li><a href="https://wa.me/628977200741">WhatsApp</a></li>
				<li><a href="https://www.instagram.com/noir.jersey/" rel="noopener">Instagram</a></li>
			</ul>
		</nav>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} NOIR. {copy.rights}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.footer-brand .wordmark {
		display: inline-flex;
		color: var(--color-ink);
	}

	.footer-brand .wordmark :global(svg) {
		width: auto;
		height: 1.75rem;
	}

	.footer-brand p {
		margin-top: 0.875rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
		max-width: 26ch;
	}

	.footer-col-title {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin-bottom: 1rem;
	}

	.site-footer nav ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.site-footer nav a {
		font-size: 0.875rem;
		color: var(--color-ink-muted);
		transition: color 0.2s ease;
	}

	.site-footer nav a:hover,
	.site-footer nav a:focus-visible {
		color: var(--color-ink);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.5rem;
		font-size: 0.8125rem;
		color: var(--color-ink-faint);
	}

	.footer-legal {
		display: flex;
		gap: 1.5rem;
	}

	.footer-legal a:hover,
	.footer-legal a:focus-visible {
		color: var(--color-ink);
	}

	@media (min-width: 700px) {
		.footer-top {
			grid-template-columns: 1.4fr 1fr 1fr 1fr;
			gap: 2rem;
		}
	}
</style>
