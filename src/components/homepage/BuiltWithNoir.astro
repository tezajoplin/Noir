---
import { Image } from 'astro:assets';
import SectionMarker from './SectionMarker.astro';
import persiwah from '../../assets/projects/persiwah-liga4-team.jpg';
import gapdol from '../../assets/projects/gapdol-team.webp';
import perngabong from '../../assets/projects/perngabong-team.jpg';
import budakGang from '../../assets/projects/budak-gang-team.jpg';

// Supporting projects keep each photograph's own proportions: the columns are
// sized by aspect ratio so the row shares one height without cropping anyone out.
const moreProjects = [
	{ name: 'Gapdol 9000', image: gapdol, alt: 'Gapdol 9000 players in olive NOIR kits walking off the pitch together', role: 'Home & away kit', href: '/our-teams/gapdol-9000/' },
	{ name: 'Perngabong', image: perngabong, alt: 'Perngabong squad in yellow and navy NOIR kits posing for a team photo', role: 'Home & away kit', href: '/our-teams/perngabong/' },
	{ name: 'Budak Gang FC', image: budakGang, alt: 'Budak Gang FC squad in white and red NOIR kits behind a championship banner', role: 'Home & away kit', href: '/our-teams/budak-gang-fc/' },
];
---

<section id="built" class="built" aria-labelledby="built-heading">
	<div class="container">
		<SectionMarker number="03" label="Built With NOIR" />

		<div class="feature">
			<figure class="feature-media">
				<Image
					src={persiwah}
					alt="Persiwah FC starting eleven in green NOIR kits, with the goalkeeper in red, behind a Liga 4 2025/26 Piala Gubernur Kalbar banner"
					widths={[640, 960, 1290]}
					sizes="(min-width: 960px) 58vw, 100vw"
					loading="lazy"
				/>
			</figure>

			<div class="feature-info">
				<p class="feature-kicker">Featured project</p>
				<h2 id="built-heading">Persiwah FC</h2>
				<p class="feature-copy">Together with Persiwah FC, NOIR designed an identity that represents the club’s fighting spirit, regional pride, and ambition to keep climbing higher.</p>

				<dl class="feature-meta">
					<div>
						<dt>Partnership</dt>
						<dd>Official Jersey Partner</dd>
					</div>
					<div>
						<dt>Season</dt>
						<dd>Champions, Liga 4<br />Piala Gubernur Kalbar 2026</dd>
					</div>
				</dl>

				<a class="link-arrow" href="/our-teams/persiwah-fc/">
					View Project
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<div class="more">
			<h3 class="more-title">More projects</h3>
			<ul class="more-list">
				{
					moreProjects.map((project) => (
						<li style={`--ratio: ${project.image.width / project.image.height}`}>
							<a href={project.href}>
								<span class="more-photo">
									<Image src={project.image} alt={project.alt} widths={[480, 800]} sizes="(min-width: 960px) 34vw, 100vw" loading="lazy" />
								</span>
								<span class="more-caption">
									<span class="more-name">{project.name}</span>
									<span class="more-role">{project.role}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.built {
		padding-block: 0 clamp(2.5rem, 4.5vw, 4rem);
		scroll-margin-top: var(--header-h);
	}

	/* ---- Featured project ---- */
	.feature {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		column-gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.feature-media :global(img) {
		width: 100%;
		height: auto;
	}

	.feature-info {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding-bottom: 0.25rem;
	}

	.feature-kicker {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.feature-info h2 {
		margin-top: 1rem;
		font-size: clamp(2.75rem, 4.4vw, 4.25rem);
		font-weight: 700;
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.feature-copy {
		margin-top: 1.75rem;
		max-width: 36ch;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-ink-muted);
	}

	.feature-meta {
		width: 100%;
		margin-block: 2rem 2.25rem;
		border-top: 1px solid var(--color-border);
	}

	.feature-meta div {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 1rem;
		padding-block: 0.875rem;
		border-bottom: 1px solid var(--color-border);
	}

	.feature-meta dt {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-ink-faint);
		padding-top: 0.15rem;
	}

	.feature-meta dd {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.4;
	}

	/* ---- More projects ---- */
	.more {
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.more-title {
		font-size: 0.6875rem;
		font-weight: 500;
		font-stretch: 100%;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.more-list {
		display: flex;
		gap: clamp(1rem, 2vw, 1.75rem);
		margin-top: 1.5rem;
	}

	.more-list li {
		flex: var(--ratio) 1 0;
		min-width: 0;
	}

	.more-list a {
		display: block;
	}

	.more-photo {
		display: block;
		aspect-ratio: var(--ratio);
		overflow: hidden;
	}

	.more-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.more-list a:hover .more-photo :global(img),
	.more-list a:focus-visible .more-photo :global(img) {
		transform: scale(1.03);
	}

	.more-caption {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-top: 0.875rem;
	}

	.more-name {
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.01em;
	}

	.more-role {
		font-size: 0.8125rem;
		color: var(--color-ink-faint);
	}

	@media (max-width: 959px) {
		.feature {
			grid-template-columns: 1fr;
			row-gap: 2rem;
		}

		.feature-media {
			margin-inline: calc(-1 * var(--gutter));
		}

		.more-list {
			flex-direction: column;
			gap: 2rem;
		}

		.more-list li {
			flex: none;
		}
	}
</style>
