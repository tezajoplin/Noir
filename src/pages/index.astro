---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/homepage/Hero.astro';
import Story from '../components/homepage/Story.astro';
import BuiltWithNoir from '../components/homepage/BuiltWithNoir.astro';
import Community from '../components/homepage/Community.astro';
import Lifestyle from '../components/homepage/Lifestyle.astro';
import WhatWeMake from '../components/homepage/WhatWeMake.astro';
import HowItWorks from '../components/homepage/HowItWorks.astro';
import Faq from '../components/homepage/Faq.astro';
import FinalCTA from '../components/homepage/FinalCTA.astro';
import EditorialCanvas from '../components/homepage/EditorialCanvas.astro';
import { faqSchema } from '../components/homepage/faq-data';
import { langFromUrl } from '../i18n';

const lang = langFromUrl(Astro.url);
const meta = {
	id: {
		title: 'NOIR Jersey — Custom Jersey Pontianak untuk Tim & Komunitas',
		description: 'NOIR membuat custom jersey di Pontianak untuk tim dan komunitas olahraga: sepak bola, padel, basket, dan lainnya. Desain sudah termasuk, pesanan minimum 10 pcs. Pesan lewat WhatsApp atau booth.',
	},
	en: {
		title: 'NOIR Jersey — Custom Jerseys in Pontianak for Teams & Communities',
		description: 'NOIR makes custom jerseys in Pontianak for sports teams and communities: football, padel, basketball and more. Design included, minimum order 10 pcs. Order via WhatsApp or at the booth.',
	},
}[lang];
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	schema={[faqSchema(lang)]}
>
	<EditorialCanvas>
		<Hero />
		<Story />
		<BuiltWithNoir />
		<Community />
		<Lifestyle />
		<WhatWeMake />
		<HowItWorks />
		<Faq />
		<FinalCTA />
	</EditorialCanvas>
</BaseLayout>
