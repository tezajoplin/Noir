---
import SectionMarker from './SectionMarker.astro';
import { langFromUrl } from '../../i18n';

const lang = langFromUrl(Astro.url);
const copy = {
	id: {
		steps: [
			{ index: '01', name: 'Sampaikan ide brilian Anda', copy: 'Kirim gambar referensi atau ceritakan seperti apa jersey yang Anda bayangkan.' },
			{ index: '02', name: 'Desain & revisi', copy: 'Tim NOIR menyiapkan desain sesuai permintaan Anda. Jika memerlukan revisi, jangan sungkan untuk memberi tahu kami.' },
			{ index: '03', name: 'Diskusikan waktu', copy: 'Waktu produksi NOIR bergantung pada antrean pesanan pada saat itu.' },
			{ index: '04', name: 'Sistem pengambilan', copy: 'Untuk jersey yang sudah selesai, Anda bisa mengambilnya di booth kami di Jalan Paris 1, Gang Perwira No. 16 A, Pontianak. Bisa juga dikirim ke luar kota melalui kargo, atau jika Anda berada di sekitar Pontianak, melalui Maxim atau GoSend.' },
		],
	},
	en: {
		steps: [
			{ index: '01', name: 'Share your brilliant idea', copy: 'Send a reference image or tell us what kind of jersey you have in mind.' },
			{ index: '02', name: 'Design & revisions', copy: 'The NOIR team prepares the design you requested. If you need revisions, don\'t hesitate to tell us.' },
			{ index: '03', name: 'Discuss timing', copy: 'NOIR\'s production time depends on the order queue at that moment.' },
			{ index: '04', name: 'Pickup & delivery', copy: 'Once your jerseys are finished, collect them at our booth at Jalan Paris 1, Gang Perwira No. 16 A, Pontianak. They can also be shipped out of town by cargo, or, if you are around Pontianak, delivered by Maxim or GoSend.' },
		],
	},
}[lang];
const steps = copy.steps;
---

<section id="how-it-works" class="how-it-works" aria-labelledby="hiw-heading">
	<div class="container hiw-grid">
		<div class="hiw-intro">
			<SectionMarker number="07" label="How It Works" />
			<h2 id="hiw-heading">From idea<br />to identity.</h2>
		</div>

		<ol class="process-list" role="list">
			{
				steps.map((step) => (
					<li class="process-step">
						<span class="process-index">{step.index}</span>
						<h3 class="process-name">{step.name}</h3>
						<p class="process-copy">{step.copy}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.how-it-works {
		padding-block: clamp(3rem, 5.5vw, 5rem);
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}

	/* Headline holds the left column while the steps read as a quiet index. */
	.hiw-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		column-gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.hiw-intro {
		position: sticky;
		top: calc(var(--header-h) + 2rem);
	}

	.how-it-works h2 {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		font-size: clamp(2.75rem, 5.4vw, 5rem);
		font-weight: 700;
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.process-list {
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.process-step {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		column-gap: 1rem;
		row-gap: 0.6rem;
		padding-block: clamp(1.5rem, 2.5vw, 2rem);
		border-bottom: 1px solid var(--color-border);
	}

	.process-index {
		grid-row: 1 / 3;
		padding-top: 0.45rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--color-ink-faint);
	}

	.process-name {
		font-size: clamp(1.375rem, 2vw, 1.75rem);
		font-weight: 650;
		letter-spacing: -0.015em;
		line-height: 1.15;
	}

	.process-copy {
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
		max-width: 52ch;
	}

	@media (max-width: 899px) {
		.hiw-grid {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}

		.hiw-intro {
			position: static;
		}

		.process-step {
			grid-template-columns: 2.25rem minmax(0, 1fr);
		}
	}
</style>
