---
import { Image } from 'astro:assets';
import SectionMarker from './SectionMarker.astro';
import JerseyComposition from './JerseyComposition.astro';
import football from '../../assets/football.jpg';
import futsal from '../../assets/futsal-clean.png';
import basketball from '../../assets/basket.jpg';
import teza from '../../assets/teza.jpg';

const sports = [
 {name:'Football', image:football, alt:'Football players celebrating together in their NOIR kits.'},
 {name:'Futsal', image:futsal, alt:'BERKAT futsal players in turquoise NOIR jerseys.'},
 {name:'Basketball', image:basketball, alt:'Basketball player in a blue NOIR kit driving toward the basket.'},
];
const more = ['Padel', 'T-Shirts', 'Polo Shirts', 'Training Wear'];
---
<section id="what-we-make" class="what-we-make" aria-labelledby="wwm-heading">
 <div class="container">
  <div class="opening">
   <div class="opening-copy">
    <SectionMarker number="06" label="What We Make" />
    <h2 id="wwm-heading"><span>BUILT FOR</span><span>EVERY SPORT</span><span>WE SERVE.</span></h2>
    <p class="opening-note">NOIR is built around identity. The same standard carries across every sport we make for — football, futsal, basketball, and beyond. Every piece is designed with intent and produced with real craftsmanship, not pulled from a generic template.</p>
    <nav class="collection-index" aria-label="Explore our sports">
     {sports.map(sport => <a href={`#noir-${sport.name.toLowerCase()}`}>{sport.name}<span aria-hidden="true">↘</span></a>)}
    </nav>
   </div>
   <JerseyComposition />
  </div>

  <div class="catalogue">
   <div class="environment" aria-hidden="true"><Image src={teza} alt="" widths={[768,1290]} sizes="65vw" loading="lazy" /></div>
   {sports.map((sport, index) => <div class={`sport sport-${sport.name.toLowerCase()}`} id={`noir-${sport.name.toLowerCase()}`}>
    <article aria-labelledby={`heading-${sport.name.toLowerCase()}`}>
    <div class="collection">
     <div class="collection-heading">
      <div class="collection-name"><span class="collection-number">0{index + 1}</span><h3 id={`heading-${sport.name.toLowerCase()}`}>{sport.name}</h3></div>
     </div>
     <div class="collection-photo"><Image src={sport.image} alt={sport.alt} widths={[480,800,1124]} sizes={index === 0 ? '(min-width: 900px) 54vw, 90vw' : '(min-width: 900px) 36vw, 90vw'} loading="lazy" /></div>
    </div>
    </article>
    {index === 0 && <div class="more-products" aria-labelledby="more-products-heading">
     <h3 id="more-products-heading">More Products</h3>
     <ul>{more.map(name => <li>{name}</li>)}</ul>
    </div>}
   </div>)}
  </div>

 </div>
</section>

<style>
 .what-we-make { background:transparent; overflow:clip; padding-block:calc(var(--chapter-gap) / 2); scroll-margin-top:calc(var(--header-h) + 1rem); }
 .opening { display:grid; grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr); gap:clamp(1.25rem,2.5vw,2.75rem); align-items:center; }
 .opening-copy { position:relative; z-index:1; }
 h2 { font-family:var(--font-display); font-size:clamp(2.8rem,5.1vw,5rem); font-weight:650; line-height:.99; letter-spacing:var(--tracking-display); margin-top:2rem; }
 h2 span { display:block; }
 .opening-note { max-width:33rem; margin-top:1.5rem; color:var(--color-ink-muted); font-size:clamp(.95rem,1.12vw,1.06rem); line-height:1.7; }
 .collection-index { display:flex; flex-wrap:wrap; gap:.8rem 1.75rem; margin-top:1.25rem; }
 .collection-index a { display:inline-flex; gap:.65rem; align-items:center; font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; padding-block:.5rem; }
 .collection-index a:hover { text-decoration:underline; text-underline-offset:5px; }

 .catalogue { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); grid-template-areas:'football futsal' 'football basketball'; column-gap:clamp(2rem,4vw,4rem); row-gap:clamp(2rem,3vw,3rem); align-items:start; margin-top:1.25rem; }
 .environment { position:absolute; z-index:-1; inset:6rem auto -2rem -8%; width:70%; overflow:hidden; opacity:.045; pointer-events:none; mask-image:linear-gradient(to bottom,transparent,#000 25%,#000 65%,transparent); }
 .environment :global(img) { width:100%; height:100%; object-fit:cover; object-position:38% center; transform:scale(1.23); mask-image:linear-gradient(to right,transparent,#000 22%,#000 65%,transparent); }
 .sport { min-width:0; scroll-margin-top:calc(var(--header-h) + 2rem); }
 .sport-football { grid-area:football; }
 .sport-futsal { grid-area:futsal; margin-top:clamp(1.5rem,3vw,3rem); }
 .sport-basketball { grid-area:basketball; }
 .collection { display:block; }
 .collection-heading { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; margin-bottom:1.25rem; }
 .collection-name { display:flex; gap:.8rem; align-items:baseline; }
 .collection-number { font-size:.58rem; color:var(--color-ink-faint); letter-spacing:.1em; }
 .collection-name h3 { font-size:clamp(1.45rem,2.35vw,2.3rem); font-weight:550; line-height:1; letter-spacing:-.045em; }
 .sport-football .collection-name h3 { font-size:clamp(2.5rem,4.3vw,4rem); }
 .collection-photo { position:relative; overflow:hidden; }
 .sport-football .collection-photo { aspect-ratio:1.08; }
 .sport-futsal .collection-photo { aspect-ratio:2.5; }
 .sport-basketball .collection-photo { aspect-ratio:.96; }
 .sport .collection-photo :global(img) { position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; }
 .sport-football .collection-photo :global(img) { object-position:48% center; }
 .sport-futsal .collection-photo :global(img) { object-position:center 51.5%; }
 .sport-basketball .collection-photo :global(img) { object-position:59% 60%; }

 .more-products { margin-top:1.5rem; }
 .more-products h3 { font-size:.8rem; text-transform:uppercase; font-weight:500; letter-spacing:.15em; margin-bottom:.75rem; }
 .more-products ul { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; }
 .more-products li { font-size:.68rem; text-transform:uppercase; letter-spacing:.05em; line-height:1.7; }

 @media (max-width:899px) {
  .opening { grid-template-columns:1fr; gap:1.5rem; }
  h2 { font-size:clamp(2.8rem,10vw,4.5rem); margin-top:1.75rem; }
  .opening-note { margin-top:1.75rem; }
  .collection-index { margin-top:1.25rem; }
  .catalogue { grid-template-columns:1fr; grid-template-areas:'football' 'futsal' 'basketball'; gap:2.5rem; margin-top:1.25rem; }
  .sport-futsal { margin-top:0; }
  .collection-name h3 { font-size:1.7rem; }
  .sport-football .collection-name h3 { font-size:2.6rem; }
  .sport-football .collection-photo { aspect-ratio:1.16; }
  .sport-basketball .collection-photo { aspect-ratio:.92; }
  .environment { display:none; }
 }
 @media (min-width:900px) and (max-width:1100px) {
  .sport-basketball .collection-heading { align-items:flex-start; flex-direction:column; gap:.6rem; }
 }
</style>
