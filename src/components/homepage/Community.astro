---
import { langFromUrl, lp } from '../../i18n';
import { Image } from 'astro:assets';
import SectionMarker from './SectionMarker.astro';
import community from '../../assets/community-padel.jpg';

const lang = langFromUrl(Astro.url);
const alt = {
	id: 'Empat pemain padel berjersey NOIR merah saling tos di samping net.',
	en: 'Four padel players in red NOIR jerseys sharing a high-five beside the net.',
}[lang];

---
<section id="community" class="community" aria-labelledby="community-heading">
 <div class="container chapter">
  <div class="copy">
   <SectionMarker number="04" label="Community" />
   <h2 id="community-heading">
    <span class="origin"><span class="lead">MADE FROM</span> PONTIANAK.</span>
    <span class="belonging">WORN BY<br />THE COMMUNITY.</span>
   </h2>
  </div>
  <figure class="photograph">
   <figcaption class="meta">PONTIANAK / WEST KALIMANTAN</figcaption>
   <Image src={community} alt={alt} widths={[480,768,1058,1290]} sizes="(min-width: 1440px) 604px, (min-width: 960px) 44vw, 100vw" loading="lazy" class="community-image" />
  </figure>
 </div>
</section>
<style>
.community {
 background: transparent;
 padding-block: clamp(2rem, 4vw, 3.5rem) 0;
 scroll-margin-top: var(--header-h);
}
.chapter {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: clamp(2rem, 5vw, 4.5rem);
 align-items: start;
}
.copy { min-width: 0; }
h2 { margin-top: clamp(2rem, 4vw, 3.5rem); font-family: var(--font-display); font-weight: 650; letter-spacing: var(--tracking-display); }
.origin { display: block; font-size: clamp(3rem, 5.2vw, 4.6rem); line-height: 1.02; }
.lead { display: block; font-size: .48em; letter-spacing: -.04em; line-height: 1.3; margin-bottom: .25em; }
.belonging { display: block; margin-top: .85em; font-size: clamp(2rem, 3.25vw, 2.9rem); line-height: 1.1; }
.photograph { min-width: 0; }
.meta { margin-bottom: 1.75rem; font-size: .65rem; letter-spacing: .18em; color: #555; line-height: 1.7; }
/* Frame out the headline baked into the original photo without retouching the players. */
.community-image { width: 100%; height: auto; aspect-ratio: 1290 / 1392; object-fit: cover; object-position: bottom; }
@media (max-width: 959px) {
 .community { padding-bottom: 1rem; }
 .chapter { grid-template-columns: 1fr; gap: 2rem; padding-right: var(--gutter); }
 h2 { margin-top: 1.75rem; }
 .origin { font-size: clamp(2.75rem, 8.5vw, 5rem); }
 .belonging { margin-top: .7em; font-size: clamp(1.9rem, 6vw, 3.5rem); }
 .photograph { margin-inline: calc(-1 * var(--gutter)); }
 .meta { padding-inline: var(--gutter); margin-bottom: 1rem; }
}
</style>
