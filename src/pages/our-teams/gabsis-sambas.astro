---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/homepage/FinalCTA.astro';
---

<BaseLayout
	title="Gabsis Sambas — NOIR"
	description="Gabsis Sambas, Liga 4 Pontianak champions 2025: player and goalkeeper kits, home and away, by NOIR."
>
	<article class="project-page">
		<header class="project-intro container">
			<a class="back-link" href="/#built"><span aria-hidden="true">←</span> All projects</a>
			<div class="intro-grid">
				<div class="intro-copy">
					<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Kit project <span class="project-index">/ Gabsis Sambas</span></p>
					<h1>Gabsis<br />Sambas.</h1>
					<p class="project-summary">Champions of Liga 4 Pontianak 2025, with a full kit set for players and goalkeepers, home and away.</p>
					<div class="project-meta">
						<span>Champions, Liga 4 Pontianak 2025</span>
						<span>Player & goalkeeper kits</span>
					</div>
				</div>
				<figure class="intro-photo">
					<img src="/images/projects/gabsis-player-pair-cutout.webp" alt="Mockup of Gabsis Sambas' yellow-and-black home kit and sky-blue-and-white away kit, each with the Sambas Berkah Berkemajuan mark across the chest" width="1468" height="1002" loading="eager" />
				</figure>
			</div>
		</header>

		<section class="kit-section container" aria-labelledby="player-heading">
			<div class="section-heading">
				<div>
					<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Player kit</p>
					<h2 id="player-heading">Yellow at home.<br /><span>Sky blue away.</span></h2>
				</div>
				<p class="section-note">The Sambas Berkah Berkemajuan mark runs across the chest of all four Gabsis kits.</p>
			</div>
			<div class="kit-notes">
				<article><span>01 / HOME</span><h3>Yellow & black</h3><p>A yellow shirt with black trim and black shorts.</p><div class="swatches" aria-label="Yellow and black kit colors"><i class="swatch-yellow"></i><i class="swatch-black"></i></div></article>
				<article><span>02 / AWAY</span><h3>Sky blue & white</h3><p>A sky-blue shirt with white shorts.</p><div class="swatches" aria-label="Sky blue and white kit colors"><i class="swatch-sky"></i><i class="swatch-white"></i></div></article>
			</div>
			<div class="design-board-intro">
				<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> NOIR design mockups</p>
				<p>Full kit layouts show the chosen colours, nameset, and sponsor placement before production.</p>
			</div>
			<div class="design-board-grid">
				<figure class="design-board">
					<img src="/images/projects/gabsis-player-home-design.webp" alt="NOIR design mockup for the Gabsis Sambas yellow-and-black player home kit, front and back" width="1600" height="1246" loading="lazy" />
					<figcaption><span>01</span> Player home · Yellow & black</figcaption>
				</figure>
				<figure class="design-board">
					<img src="/images/projects/gabsis-player-away-design.webp" alt="NOIR design mockup for the Gabsis Sambas sky-blue player away kit, front and back" width="1600" height="1246" loading="lazy" />
					<figcaption><span>02</span> Player away · Sky blue & white</figcaption>
				</figure>
			</div>
		</section>

		<section class="kit-section container" aria-labelledby="keeper-heading">
			<div class="section-heading">
				<div>
					<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Goalkeeper kit</p>
					<h2 id="keeper-heading">Red at home.<br /><span>Green away.</span></h2>
				</div>
				<p class="section-note">Goalkeepers get their own pair, built around the same crest and chest mark.</p>
			</div>
			<figure class="kit-pair">
				<img src="/images/projects/gabsis-keeper-pair-cutout.webp" alt="Mockup of Gabsis Sambas' red goalkeeper home kit and green goalkeeper away kit" width="1435" height="983" loading="lazy" />
			</figure>
			<div class="kit-notes">
				<article><span>01 / HOME</span><h3>Red</h3><p>A red goalkeeper shirt and shorts.</p><div class="swatches" aria-label="Red kit color"><i class="swatch-red"></i></div></article>
				<article><span>02 / AWAY</span><h3>Green</h3><p>A green goalkeeper shirt and shorts.</p><div class="swatches" aria-label="Green kit color"><i class="swatch-green"></i></div></article>
			</div>
			<div class="design-board-grid">
				<figure class="design-board">
					<img src="/images/projects/gabsis-keeper-home-design.webp" alt="NOIR design mockup for the Gabsis Sambas red goalkeeper home kit, front and back" width="1600" height="1246" loading="lazy" />
					<figcaption><span>01</span> Goalkeeper home · Red</figcaption>
				</figure>
				<figure class="design-board">
					<img src="/images/projects/gabsis-keeper-away-design.webp" alt="NOIR design mockup for the Gabsis Sambas green goalkeeper away kit, front and back" width="1600" height="1246" loading="lazy" />
					<figcaption><span>02</span> Goalkeeper away · Green</figcaption>
				</figure>
			</div>
		</section>

		<footer class="project-outro container">
			<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Made with NOIR</p>
			<a class="outro-link" href="/#built">Explore more projects <span aria-hidden="true">→</span></a>
		</footer>
	</article>
	<FinalCTA number="" />
</BaseLayout>

<style>
	.project-page { overflow: clip; }
	.project-intro { padding-top: clamp(2rem, 4vw, 4rem); }
	.back-link { display: inline-flex; gap: .65rem; align-items: center; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-ink-muted); }
	.back-link span { font-size: 1rem; }
	.intro-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 7vw, 7rem); align-items: center; margin-top: clamp(2.25rem, 5vw, 5rem); }
	.intro-copy { padding-block: 1rem; }
	.project-index { color: var(--color-ink-faint); }
	h1 { margin-top: 1.5rem; font-size: clamp(3rem, 4.1vw, 4.5rem); line-height: .9; letter-spacing: var(--tracking-display); font-weight: 700; text-transform: uppercase; }
	.project-summary { max-width: 25rem; margin-top: 2rem; font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.5; color: var(--color-ink-muted); }
	.project-meta { display: flex; flex-wrap: wrap; gap: .65rem 1.6rem; margin-top: 2rem; padding-top: 1.1rem; border-top: 1px solid var(--color-border); font-size: .67rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-ink-faint); }
	.intro-photo { position: relative; margin: 0; overflow: hidden; background: transparent; }
	.intro-photo img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; }
	.intro-photo figcaption { position: absolute; inset: auto 1.2rem 1rem; color: #fff; font-size: .65rem; letter-spacing: .13em; text-transform: uppercase; text-shadow: 0 1px 12px #0008; }
	.kit-section { padding-top: clamp(4rem, 7vw, 6.5rem); }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 4vw, 4rem); }
	.section-heading h2 { margin-top: 1.4rem; font-size: clamp(2.5rem, 5.5vw, 5.5rem); line-height: .92; letter-spacing: var(--tracking-display); text-transform: uppercase; }
	.section-heading h2 span { color: var(--color-ink-faint); }
	.section-note { max-width: 20rem; padding-bottom: .4rem; color: var(--color-ink-muted); font-size: .95rem; }
	.kit-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: clamp(2rem, 4vw, 4rem); border-top: 1px solid var(--color-border); }
	.kit-notes article { padding-top: 1.2rem; }
	.kit-notes article > span { color: var(--color-ink-faint); font-size: .65rem; letter-spacing: .14em; }
	.kit-notes h3 { margin-top: .9rem; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -.015em; }
	.kit-notes p { max-width: 25rem; margin-top: .6rem; color: var(--color-ink-muted); font-size: .9rem; }
	.swatch-yellow { background: #f4dc04; }
	.swatch-black { background: #171719; }
	.swatch-sky { background: #82cfeb; }
	.swatch-white { background: #e4e3de; }
	.swatch-red { background: #d2272d; }
	.swatch-green { background: #008043; }
	.intro-photo img, .kit-pair img { filter: drop-shadow(0 0 1px rgb(0 0 0 / .22)); }
	.kit-pair { margin: clamp(2rem, 4vw, 4rem) 0 0; }
	.kit-pair img { display: block; width: 100%; max-width: 62rem; height: auto; margin-inline: auto; }
	.design-board-intro { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; margin-top: clamp(3.5rem, 7vw, 7rem); padding-top: 1.1rem; border-top: 1px solid var(--color-border); }
	.design-board-intro > p:last-child { max-width: 24rem; color: var(--color-ink-muted); font-size: .88rem; line-height: 1.6; }
	.design-board-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.6vw, 2.5rem); margin-top: clamp(1.5rem, 3vw, 2.5rem); }
	.design-board { min-width: 0; margin: 0; }
	.design-board img { display: block; width: 100%; height: auto; background: #f1f3f2; }
	.design-board figcaption { display: flex; gap: .9rem; padding-top: .8rem; color: var(--color-ink-muted); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
	.design-board figcaption span { color: var(--color-ink-faint); }
	.swatches { display: flex; gap: .4rem; margin-top: 1.1rem; }
	.swatches i { width: 2.6rem; height: .38rem; }
	.project-outro { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: clamp(1.5rem, 3vw, 2.5rem); border-block: 1px solid var(--color-border); margin-block: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
	.outro-link { display: flex; align-items: center; gap: 1rem; font-size: clamp(1.2rem, 2vw, 1.8rem); letter-spacing: -.03em; }
	.outro-link span { color: var(--color-ink-faint); transition: transform .2s ease; }
	.outro-link:hover span { transform: translateX(.3rem); }
	@media (max-width: 760px) {
		.intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
		.intro-copy { padding: 0; }
		h1 { font-size: clamp(3.3rem, 12vw, 5rem); }
		.section-heading { align-items: start; flex-direction: column; }
		.section-note { max-width: 32rem; }
		.kit-notes { grid-template-columns: 1fr; gap: 1.4rem; }
		.design-board-intro { align-items: start; flex-direction: column; gap: .7rem; }
		.design-board-grid { grid-template-columns: 1fr; gap: 2rem; }
		.project-outro { align-items: start; flex-direction: column; }
	}
</style>
