---
import { Image } from 'astro:assets';
import SectionMarker from './SectionMarker.astro';
import lifestyle from '../../assets/lifestyle-cafe.jpg';
---
<section id="lifestyle" class="lifestyle" aria-labelledby="lifestyle-heading">
 <div class="container chapter">
  <div class="copy">
   <SectionMarker number="05" label="Lifestyle" />
   <h2 id="lifestyle-heading">
    <span class="pitch">MADE FOR<br />THE PITCH.</span>
    <span class="everywhere">WORN<br /> EVERYWHERE<br /> ELSE.</span>
   </h2>
   <p class="meta">ON THE PITCH / OFF THE PITCH</p>
  </div>
  <Image src={lifestyle} alt="Five people wearing NOIR jerseys with everyday clothing, gathered inside a café." widths={[480,768,1290]} sizes="(min-width: 1440px) 604px, (min-width: 960px) 44vw, 88vw" loading="lazy" class="lifestyle-image" />
 </div>
</section>
<style>
.lifestyle {
 /* The photo starts in Community's open left column; the copy starts below its right photo. */
 --chapter-overlap: clamp(10rem, 19vw, 17rem);
 margin-top: calc(-1 * var(--chapter-overlap));
 padding-block: 0 calc(var(--chapter-gap) / 2);
 scroll-margin-top: var(--header-h);
}
.chapter {
 display: grid;
 grid-template-columns: 1fr 1fr;
 column-gap: clamp(2rem, 5vw, 4.5rem);
 align-items: start;
}
.copy { grid-column: 2; grid-row: 1; min-width: 0; padding-top: calc(var(--chapter-overlap) + 2.5rem); }
.lifestyle-image { grid-column: 1; grid-row: 1; width: 100%; height: auto; }
h2 { margin-block: clamp(2rem, 3vw, 3rem); font-family: var(--font-display); font-weight: 650; letter-spacing: var(--tracking-display); }
.pitch { display: block; font-size: clamp(1.9rem, 3.1vw, 2.75rem); line-height: 1.12; }
.everywhere { display: block; margin-top: .55em; font-size: clamp(2.8rem, 5.25vw, 4.7rem); line-height: .99; }
.meta { font-size: .65rem; letter-spacing: .18em; line-height: 1.7; color: #555; }
@media (max-width: 959px) {
 .lifestyle { margin-top: 0; padding-top: 1rem; }
 .chapter { grid-template-columns: 1fr; gap: 2rem; }
 .copy { grid-column: 1; grid-row: 1; padding-block: 0; }
 .lifestyle-image { grid-column: 1; grid-row: 2; }
 h2 { margin-block: 1.75rem 1.5rem; }
 .pitch { font-size: clamp(1.75rem, 5.5vw, 2.5rem); }
 .everywhere { margin-top: .65em; font-size: clamp(2rem, 7.2vw, 3.5rem); line-height: 1.06; }
 .everywhere br { display: none; }
}
</style>
