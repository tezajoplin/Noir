---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMarker from '../components/homepage/SectionMarker.astro';
import FinalCTA from '../components/homepage/FinalCTA.astro';
import { langFromUrl } from '../i18n';

const lang = langFromUrl(Astro.url);

const copy = {
	id: {
		title: 'Tentang NOIR — Jersey Custom dari Pontianak',
		description: 'NOIR adalah brand pakaian olahraga custom dari Pontianak, Kalimantan Barat, berdiri Juli 2022 oleh Miguel Tjondro untuk tim olahraga amatir dan komunitas.',
		facts: [
			{ label: 'Berdiri', value: 'Juli 2022' },
			{ label: 'Pendiri', value: 'Miguel Tjondro' },
			{ label: 'Berbasis di', value: 'Pontianak, Kalimantan Barat' },
			{ label: 'Tim', value: 'Ratusan' },
			{ label: 'Pcs dibuat', value: '30.000+' },
		],
		lead: 'NOIR dibuat pada Juli 2022 untuk memenuhi kebutuhan spesifik tim olahraga amatir dan komunitas.',
		p1: 'Kalimantan Barat punya budaya sepak bola yang mengakar. Komunitas dan tim baru terus bermunculan, tetapi banyak yang masih memakai template jersey generik dengan sekadar tambahan nama tim.',
		p2: 'Sebuah jersey seharusnya mewakili lebih dari sebuah nama. NOIR membantu tim membangun identitas yang mencerminkan karakter mereka, lewat desain yang matang, pengerjaan yang bisa diandalkan, produksi cepat, dan harga yang kompetitif.',
		photoAlt: 'Anggota tim NOIR menata desain kit di komputer, di samping printer format besar',
		photoCaption: 'Di balik jersey',
		valuesTitle: 'Yang menuntun kerja kami',
		values: [
			{ name: 'Identitas lebih dulu', copy: 'Setiap produk harus memperkuat identitas tim, bukan sekadar memenuhi pesanan.' },
			{ name: 'Kualitas itu penting', copy: 'Bahan, pengerjaan, dan finishing sama-sama penting.' },
			{ name: 'Kemitraan dengan pelanggan', copy: 'NOIR bekerja bersama pelanggan untuk mewujudkan visi mereka.' },
			{ name: 'Terus berbenah', copy: 'Produk, layanan, dan proses terus diperbaiki lewat masukan dan inovasi.' },
		],
	},
	en: {
		title: 'About — NOIR',
		description: 'NOIR is a custom sportswear brand from Pontianak, West Kalimantan, founded in July 2022 by Miguel Tjondro for amateur sports and community teams.',
		facts: [
			{ label: 'Founded', value: 'July 2022' },
			{ label: 'Founder', value: 'Miguel Tjondro' },
			{ label: 'Based in', value: 'Pontianak, West Kalimantan' },
			{ label: 'Teams', value: 'Hundreds' },
			{ label: 'Pieces made', value: '30,000+' },
		],
		lead: 'NOIR was created in July 2022 to meet the specific needs of amateur sports and community teams.',
		p1: 'West Kalimantan has a deep-rooted football culture. New communities and teams are formed all the time, yet many still wear generic templates with only a team name added.',
		p2: 'A jersey should represent more than a name. NOIR helps teams build an identity that reflects their character, through thoughtful design, reliable craftsmanship, fast production and competitive pricing.',
		photoAlt: 'A NOIR team member laying out a kit design on a computer, beside a large-format printer',
		photoCaption: 'Behind the jerseys',
		valuesTitle: 'What guides the work',
		values: [
			{ name: 'Identity first', copy: 'Every product should strengthen a team’s identity, not just fulfil an order.' },
			{ name: 'Quality matters', copy: 'Materials, craftsmanship and finishing matter.' },
			{ name: 'Customer partnership', copy: 'NOIR works together with customers to bring their vision to life.' },
			{ name: 'Continuous improvement', copy: 'Products, services and processes keep improving through feedback and innovation.' },
		],
	},
}[lang];
const { facts, values } = copy;
---

<BaseLayout
	title={copy.title}
	description={copy.description}
>
	<section class="about container" aria-labelledby="about-heading">
		<SectionMarker label="About" />
		<h1 id="about-heading">Pontianak,<br />since 2022.</h1>

		<div class="about-body">
			<dl class="about-facts">
				{facts.map((fact) => (
					<div>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>

			<div class="about-copy">
				<p class="about-lead">{copy.lead}</p>
				<p>{copy.p1}</p>
				<p>{copy.p2}</p>
			</div>

			<figure class="about-photo">
				<img src="/images/about/workspace.webp" alt={copy.photoAlt} width="1000" height="1333" loading="lazy" />
				<figcaption>{copy.photoCaption}</figcaption>
			</figure>
		</div>

		<div class="about-values">
			<h2 class="values-title">{copy.valuesTitle}</h2>
			<ol>
				{values.map((value, index) => (
					<li>
						<span class="values-index">{String(index + 1).padStart(2, '0')}</span>
						<h3>{value.name}</h3>
						<p>{value.copy}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<FinalCTA number="" />
</BaseLayout>

<style>
	.about {
		padding-block: clamp(3rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5rem);
	}

	.about h1 {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		font-size: clamp(3.25rem, 9.2vw, 9.25rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.about-body {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
		column-gap: clamp(2rem, 6vw, 6rem);
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
		border-top: 1px solid var(--color-border);
	}

	.about-facts {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}

	.about-facts dt,
	.values-title,
	.values-index {
		font-size: 0.6875rem;
		font-weight: 500;
		font-stretch: 100%;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.about-facts dd {
		margin-top: 0.5rem;
		font-size: clamp(1.25rem, 1.9vw, 1.75rem);
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.about-copy {
		grid-column: 2;
		grid-row: 1 / span 2;
		max-width: 38rem;
	}

	.about-facts {
		grid-column: 1;
	}

	.about-photo {
		grid-column: 1;
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
	}

	.about-photo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.about-photo figcaption {
		margin-top: 0.7rem;
		font-size: 0.625rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.about-copy p {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-ink-muted);
	}

	.about-copy p + p {
		margin-top: 1.25rem;
	}

	.about-copy .about-lead {
		margin-bottom: 1.75rem;
		font-size: clamp(1.5rem, 2.4vw, 2.125rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.about-values {
		margin-top: clamp(3rem, 6vw, 5.5rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.about-values ol {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 3rem);
		margin-top: 1.75rem;
	}

	.about-values h3 {
		margin-top: 0.75rem;
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		letter-spacing: -0.015em;
	}

	.about-values li p {
		max-width: 22rem;
		margin-top: 0.6rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
	}

	@media (max-width: 899px) {
		.about-body {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}

		.about-facts,
		.about-copy,
		.about-photo {
			grid-column: 1;
			grid-row: auto;
		}

		.about-photo {
			margin-top: 0;
			max-width: 30rem;
		}

		.about-values ol {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 559px) {
		.about-values ol {
			grid-template-columns: 1fr;
		}
	}
</style>
