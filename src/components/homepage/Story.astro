---
import { langFromUrl, lp } from '../../i18n';
import SectionMarker from './SectionMarker.astro';

const lang = langFromUrl(Astro.url);
const copy = {
	id: {
		one: 'Kami meyakini setiap tim mempunyai cerita.',
		two: 'Rasa bangga, rasa jerih payah, rasa haus akan suatu tujuan adalah motivasi Noir untuk membantu Anda.',
	},
	en: {
		one: 'A jersey can indeed carry a name.',
		two: 'But the right jersey can carry something of greater value.',
	},
}[lang];

// Brand sign-off, English in both languages like the section headline.
const payoff = ['Your Identity.', 'We Build.', '#noirjak'];

---
<section id="story" class="story" aria-labelledby="story-heading">
	<div class="story-copy">
		<SectionMarker number="02" label="The Story" />

		<h2 id="story-heading">Every team<br />has a story.</h2>

		<p class="story-message">
			<span>{copy.one}</span>
			<span>{copy.two}</span>
		</p>

		<p class="story-payoff">
			<span>{payoff[0]}</span>
			<span>{payoff[1]}</span>
			<span>{payoff[2]}</span>
		</p>
	</div>
</section>

<style>
	.story {
		position: relative;
		color: var(--color-ink);
		scroll-margin-top: var(--header-h);
	}

	/* Typography only: the headline carries the section, the message sits beside it
	   on the right, and the sign-off closes it as one large line. */
	.story-copy {
		width: min(var(--container-max), 100%);
		margin-inline: auto;
		padding: clamp(3rem, 6vw, 5.5rem) var(--gutter);
		min-height: clamp(30rem, 48vw, 43rem);
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: auto auto 1fr;
		column-gap: clamp(1rem, 2.5vw, 2rem);
	}

	.story-copy > :global(.eyebrow) {
		grid-column: 1 / -1;
	}

	.story-copy h2 {
		grid-column: 1 / 9;
		grid-row: 2;
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		font-size: clamp(3rem, 7.6vw, 8rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.story-message {
		grid-column: 9 / 13;
		grid-row: 2;
		align-self: end;
		max-width: 26ch;
		padding-bottom: 0.6rem;
		font-size: clamp(1.2rem, 1.7vw, 1.6rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.story-message span {
		display: block;
	}

	.story-message span + span {
		margin-top: 0.6em;
		font-size: 0.82em;
		font-weight: 400;
		color: var(--color-ink-muted);
	}

	.story-payoff {
		grid-column: 1 / -1;
		grid-row: 3;
		align-self: end;
		margin-top: 3rem;
		padding-top: 1.6rem;
		border-top: 1px solid var(--color-border);
		display: flex;
		flex-wrap: wrap;
		column-gap: 0.35em;
		font-size: clamp(2rem, 5.4vw, 5.6rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: var(--tracking-display);
	}

	/* Two quiet words, then the hashtag in full ink. */
	.story-payoff span {
		color: var(--color-ink-faint);
	}

	.story-payoff span:last-child {
		color: var(--color-ink);
	}

	@media (max-width: 899px) {
		.story-copy {
			display: block;
			min-height: 0;
		}

		.story-message {
			max-width: 24ch;
			margin-top: 2.5rem;
			padding-bottom: 0;
		}

		.story-payoff {
			margin-top: 3rem;
			font-size: clamp(2rem, 10vw, 3.25rem);
		}
	}
</style>
