---
import { langFromUrl, lp } from '../../i18n';
import { Image } from 'astro:assets';
import SectionMarker from './SectionMarker.astro';
import player from '../../assets/story-player.jpg';

const lang = langFromUrl(Astro.url);
const copy = {
	id: {
		one: 'Kami meyakini setiap tim mempunyai cerita.',
		two: 'Rasa bangga, rasa jerih payah, rasa haus akan suatu tujuan adalah motivasi Noir untuk membantu Anda.',
		payoff: ['Identitas.', 'Kebanggaan.', 'Rasa memiliki.'],
	},
	en: {
		one: 'A jersey can indeed carry a name.',
		two: 'But the right jersey can carry something of greater value.',
		payoff: ['Identity.', 'Pride.', 'Belonging.'],
	},
}[lang];

---
<section id="story" class="story" aria-labelledby="story-heading">
	<Image
		class="story-photo"
		src={player}
		widths={[640, 960, 1280]}
		sizes="(min-width: 900px) 50vw, 100vw"
		quality={80}
		alt=""
		loading="lazy"
	/>
	<div class="story-copy">
		<SectionMarker number="02" label="The Story" />

		<h2 id="story-heading">Every team<br />has a story.</h2>

		<p class="story-message">
			<span>{copy.one}</span>
			<span>{copy.two}</span>
		</p>

		<div class="story-signoff">
			<p class="story-payoff">
				<span>{copy.payoff[0]}</span>
				<span>{copy.payoff[1]}</span>
				<span>{copy.payoff[2]}</span>
			</p>
			<p class="story-tagline">#NOIRJAK</p>
		</div>
	</div>
</section>

<style>
	.story {
		position: relative;
		overflow: hidden;
		color: var(--color-ink);
		scroll-margin-top: var(--header-h);
	}

	/* A grey-scale photograph held back to a quiet 27%, so the type stays the voice
	   of the section. The photo is already black and white. */
	.story-photo {
		position: absolute;
		inset: 0 0 0 auto;
		width: 50%;
		height: 100%;
		object-fit: cover;
		object-position: 58% 22%;
		opacity: 0.27;
	}

	.story-copy {
		position: relative;
		width: min(var(--container-max), 100%);
		margin-inline: auto;
		padding: clamp(3rem, 6vw, 5.5rem) var(--gutter);
		min-height: clamp(36rem, 62vw, 51rem);
		display: flex;
		flex-direction: column;
	}

	.story-copy h2 {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		font-size: clamp(3rem, 6.8vw, 7.2rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.story-message {
		max-width: 21ch;
		margin-top: clamp(2rem, 3.5vw, 2.75rem);
		font-size: clamp(1.2rem, 1.7vw, 1.6rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.story-message span {
		display: block;
	}

	.story-message span + span {
		margin-top: 0.6em;
		font-size: 0.82em;
		font-weight: 400;
		color: var(--color-ink-muted);
	}

	.story-signoff {
		margin-top: auto;
		padding-top: 2.5rem;
	}

	.story-payoff {
		font-size: clamp(2rem, 3.6vw, 3.4rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	/* Identity and Pride step back; Belonging lands in full ink. */
	.story-payoff span {
		display: block;
		color: var(--color-ink-faint);
	}

	.story-payoff span:last-child {
		color: var(--color-ink);
	}

	.story-tagline {
		margin-top: 1.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1;
		color: var(--color-ink-muted);
	}

	@media (max-width: 899px) {
		.story {
			display: flex;
			flex-direction: column;
		}

		.story-photo {
			position: relative;
			inset: auto;
			order: -1;
			width: 100%;
			height: 62vw;
		}

		.story-copy {
			min-height: 0;
			padding-top: 2.5rem;
		}

		.story-signoff {
			margin-top: 0;
		}
	}
</style>
