---
import '@fontsource-variable/instrument-sans/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langFromUrl, languages, pathForLang } from '../i18n';

interface Props {
	title: string;
	description?: string;
	image?: string;
    noindex?: boolean;
	schema?: object[];
}

const {
	title,
	image = '/og-image.jpg',
    noindex = false,
	schema: extraSchema = [],
	description = 'NOIR — premium custom sportswear built around team identity.',
} = Astro.props;

const lang = langFromUrl(Astro.url);
const alternates = (Object.keys(languages) as Array<keyof typeof languages>).map((code) => ({
	code,
	href: new URL(pathForLang(Astro.url.pathname, code), Astro.site),
}));

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Only facts confirmed by the owner; no ratings, hours, prices or geo.
const orgSchema = {
	'@context': 'https://schema.org',
	'@type': ['Organization', 'LocalBusiness'],
	'@id': new URL('/#noir', Astro.site).href,
	name: 'NOIR',
	url: new URL('/', Astro.site).href,
	logo: new URL('/apple-touch-icon.png', Astro.site).href,
	image: ogImage.href,
	description: 'NOIR — premium custom sportswear built around team identity, from Pontianak, West Kalimantan.',
	foundingDate: '2022-07',
	founder: { '@type': 'Person', name: 'Miguel Tjondro' },
	telephone: '+62 895 4142 92999',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Jalan Paris 1, Gang Perwira No. 16 A',
		addressLocality: 'Pontianak',
		addressRegion: 'Kalimantan Barat',
		addressCountry: 'ID',
	},
	sameAs: ['https://www.instagram.com/noir.jersey/'],
};
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates[0].href} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#fafaf9" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="NOIR" />
		<meta property="og:locale" content={languages[lang].ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="800" />
		<meta name="twitter:card" content="summary_large_image" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
		{[orgSchema, ...extraSchema].map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
	</head>
	<body>
		<a class="skip-link" href="#main">{lang === 'en' ? 'Skip to main content' : 'Lewati ke konten utama'}</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
