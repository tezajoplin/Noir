---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/homepage/FinalCTA.astro';
---

<BaseLayout
	title="Budak Gang FC — NOIR"
	description="Budak Gang FC home and away kit project by NOIR."
>
	<article class="project-page">
		<header class="project-intro container">
			<a class="back-link" href="/#built"><span aria-hidden="true">←</span> All projects</a>
			<div class="intro-grid">
				<div class="intro-copy">
					<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Kit project <span class="project-index">/ Budak Gang FC</span></p>
					<h1>Budak Gang<br />FC.</h1>
					<p class="project-summary">A white home kit and a red alternate, connected by the club crest and a flowing marbled pattern.</p>
					<div class="project-meta">
						<span>Home & away</span>
						<span>Custom football kits</span>
					</div>
				</div>
				<figure class="intro-photo">
					<img src="/images/projects/budak-gang-studio-pair-cutout-v2.webp" alt="Transparent mockup of Budak Gang FC's white home kit and red alternate kit" loading="eager" />
					<figcaption>Budak Gang FC · Home & away kit</figcaption>
				</figure>
			</div>
		</header>

		<section class="kit-section container" aria-labelledby="kit-heading">
			<div class="section-heading">
				<div>
					<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> NOIR design mockups</p>
					<h2 id="kit-heading">White at home.<br /><span>Red away.</span></h2>
				</div>
				<p class="section-note">The home shirt pairs a white base with red trim and a chest stripe. The alternate carries the same crest and details on a marbled red base.</p>
			</div>

			<div class="kit-grid">
				<figure class="kit-board">
					<img src="/images/projects/budak-gang-home.webp" alt="Budak Gang FC white home kit design board showing front, back, shorts, colors and sponsor placements" loading="lazy" />
					<figcaption><span>01</span> Home kit · White & red</figcaption>
				</figure>
				<figure class="kit-board">
					<img src="/images/projects/budak-gang-away.webp" alt="Budak Gang FC red away kit design board showing front, back, shorts, colors and sponsor placements" loading="lazy" />
					<figcaption><span>02</span> Away kit · Red & white</figcaption>
				</figure>
			</div>
			<p class="render-note">Design boards show the proposed layout; final logo and nameset sizing is confirmed during production setup.</p>
		</section>

		<section class="story-section container" aria-labelledby="story-heading">
			<div class="story-copy">
				<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> The community</p>
				<h2 id="story-heading">One gang.<br /><span>A growing team.</span></h2>
				<div class="story-body">
					<p>Budak Gang started in November 2023 as a casual kickabout among friends from the same neighborhood. At first, there were only a few of them. Then more friends joined, the games got bigger, and the team began taking part in tournaments.</p>
					<p>These photos catch the team in its matchday rhythm: on the pitch, in the middle of a game, and gathered together.</p>
				</div>
			</div>
			<div class="story-facts" aria-label="Budak Gang facts">
				<div><span>Formed</span><strong>November 2023</strong></div>
				<div><span>Started as</span><strong>Friends from one neighborhood</strong></div>
			</div>
			<div class="story-gallery">
				<figure class="story-photo story-photo-team">
					<img src="/images/budak-gang/gallery/03-team.jpg" alt="Budak Gang players gathered together after a tournament" loading="lazy" />
					<figcaption><span>01</span> The team, together</figcaption>
				</figure>
				<figure class="story-photo">
					<img src="/images/budak-gang/gallery/01-captain.webp" alt="Budak Gang captain in the white and red kit on the futsal pitch" loading="lazy" />
					<figcaption><span>02</span> Matchday</figcaption>
				</figure>
				<figure class="story-photo">
					<img src="/images/budak-gang/gallery/02-match.jpg" alt="Budak Gang player wearing number 3 during a match" loading="lazy" />
					<figcaption><span>03</span> In the game</figcaption>
				</figure>
			</div>
		</section>

		<footer class="project-outro container">
			<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Made with NOIR</p>
			<a class="outro-link" href="/#built">Explore more projects <span aria-hidden="true">→</span></a>
		</footer>
	</article>
	<FinalCTA number="" />
</BaseLayout>

<style>
	.project-page {
		overflow: clip;
		background:
			linear-gradient(
				180deg,
				rgba(0, 0, 0, 0.018) 0%,
				rgba(0, 0, 0, 0) 34%,
				rgba(0, 0, 0, 0.008) 62%,
				rgba(0, 0, 0, 0.028) 84%,
				rgba(0, 0, 0, 0.055) 100%
			),
			var(--color-bg);
	}
	.project-intro { padding-top: clamp(2rem, 4vw, 4rem); }
	.back-link { display: inline-flex; gap: .65rem; align-items: center; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-ink-muted); }
	.back-link span { font-size: 1rem; }
	.intro-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 7vw, 7rem); align-items: center; margin-top: clamp(2.25rem, 5vw, 5rem); }
	.intro-copy { padding-block: 1rem; }
	.project-index { color: var(--color-ink-faint); }
	h1 { margin-top: 1.5rem; font-size: clamp(3.2rem, 6vw, 6.5rem); line-height: .9; letter-spacing: var(--tracking-display); font-weight: 700; text-transform: uppercase; }
	.project-summary { max-width: 25rem; margin-top: 2rem; font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.5; color: var(--color-ink-muted); }
	.project-meta { display: flex; flex-wrap: wrap; gap: .65rem 1.6rem; margin-top: 2rem; padding-top: 1.1rem; border-top: 1px solid var(--color-border); font-size: .67rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-ink-faint); }
	.intro-photo { position: relative; margin: 0; background: transparent; }
	.intro-photo img { display: block; width: 123%; max-width: none; height: auto; margin-left: -11.5%; object-fit: contain; }
	.intro-photo figcaption { margin: .2rem 0 0 6%; color: var(--color-ink-faint); font-size: .65rem; letter-spacing: .13em; text-transform: uppercase; }
	.story-section { padding-top: clamp(4rem, 8vw, 7rem); }
	.story-copy { display: grid; grid-template-columns: minmax(0, .9fr) minmax(16rem, 1.1fr); column-gap: clamp(2rem, 8vw, 8rem); align-items: end; }
	.story-copy .eyebrow { grid-column: 1 / -1; }
	.story-copy h2 { margin-top: 1.35rem; font-size: clamp(2.7rem, 5.5vw, 5.5rem); line-height: .92; letter-spacing: var(--tracking-display); text-transform: uppercase; }
	.story-copy h2 span { color: var(--color-ink-faint); }
	.story-body { max-width: 34rem; padding-bottom: .25rem; color: var(--color-ink-muted); font-size: .98rem; line-height: 1.75; }
	.story-body p + p { margin-top: 1rem; }
	.story-facts { display: flex; flex-wrap: wrap; gap: 1rem clamp(2rem, 6vw, 6rem); margin-top: 2.5rem; padding-block: 1.1rem; border-block: 1px solid var(--color-border); }
	.story-facts div { display: grid; gap: .35rem; }
	.story-facts span { color: var(--color-ink-faint); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
	.story-facts strong { font-size: .85rem; font-weight: 600; }
	.story-gallery { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: clamp(1rem, 2vw, 2rem); margin-top: clamp(1.5rem, 3vw, 3rem); }
	.story-photo { min-width: 0; margin: 0; }
	.story-photo-team { grid-column: 1 / -1; }
	.story-photo img { display: block; width: 100%; height: auto; }
	.story-photo figcaption { display: flex; align-items: baseline; gap: .8rem; padding-top: .75rem; color: var(--color-ink-muted); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
	.story-photo figcaption span { color: var(--color-ink-faint); }
	.kit-section { padding-top: clamp(4rem, 7vw, 6.5rem); }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 4vw, 4rem); }
	.section-heading h2 { margin-top: 1.4rem; font-size: clamp(2.5rem, 5.5vw, 5.5rem); line-height: .92; letter-spacing: var(--tracking-display); text-transform: uppercase; }
	.section-heading h2 span { color: var(--color-ink-faint); }
	.section-note { max-width: 23rem; padding-bottom: .4rem; color: var(--color-ink-muted); font-size: .95rem; line-height: 1.65; }
	.kit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.6vw, 2.5rem); }
	.kit-board { min-width: 0; margin: 0; }
	.kit-board img { display: block; width: 100%; height: auto; background: #f5f6f5; }
	.kit-board figcaption { display: flex; gap: 1rem; align-items: baseline; padding-top: .85rem; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
	.kit-board figcaption span { color: var(--color-ink-faint); font-size: .65rem; }
	.render-note { margin-top: 1.5rem; font-size: .7rem; line-height: 1.6; letter-spacing: .04em; color: var(--color-ink-faint); }
	.project-outro { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: clamp(1.5rem, 3vw, 2.5rem); border-block: 1px solid var(--color-border); margin-block: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
	.outro-link { display: flex; align-items: center; gap: 1rem; font-size: clamp(1.2rem, 2vw, 1.8rem); letter-spacing: -.03em; }
	.outro-link span { color: var(--color-ink-faint); transition: transform .2s ease; }
	.outro-link:hover span { transform: translateX(.3rem); }
	@media (max-width: 760px) {
		.intro-grid { grid-template-columns: 1fr; gap: 2rem; }
		.intro-copy { padding: 0; }
		h1 { font-size: clamp(3.2rem, 12vw, 5rem); }
		.intro-photo img { width: 100%; max-width: 100%; margin-left: 0; }
		.story-copy { grid-template-columns: 1fr; gap: 0; }
		.story-body { margin-top: 1.5rem; }
		.story-gallery { grid-template-columns: 1fr; }
		.story-photo-team { grid-column: auto; }
		.section-heading { align-items: start; flex-direction: column; }
		.section-note { max-width: 32rem; }
		.kit-grid { grid-template-columns: 1fr; gap: 2rem; }
		.project-outro { align-items: start; flex-direction: column; }
	}
</style>
