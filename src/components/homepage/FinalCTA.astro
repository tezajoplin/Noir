---
import { langFromUrl, lp } from '../../i18n';
import SectionMarker from './SectionMarker.astro';

interface Props {
	// Homepage numbers its chapters; project pages reuse the close without one.
	number?: string;
}

const { number = '08' } = Astro.props;

const whatsapp = 'https://wa.me/628977200741';

const lang = langFromUrl(Astro.url);
const copy = {
	id: {
		sub: 'Ceritakan apa yang diperjuangkan tim Anda.',
		booth: ['Jalan Paris 1, Gang Perwira No. 16 A', 'Pontianak, Kalimantan Barat'],
	},
	en: {
		sub: 'Tell us what your team stands for.',
		booth: ['Jalan Paris 1, Gang Perwira No. 16 A', 'Pontianak, West Kalimantan'],
	},
}[lang];

---

<section id="final-cta" class="final-cta" aria-labelledby="final-cta-heading">
	<div class="container final-cta-inner">
		<SectionMarker number={number} label="Let's Build It" />

		<h2 id="final-cta-heading">Your team.<br />Your identity.<br />Let's build it.</h2>

		<div class="final-cta-foot">
			<div class="final-cta-action">
				<p class="final-cta-sub">{copy.sub}</p>
				<a class="btn" href={lp(lang, '/get-a-quote/')}>
					Start a Project
					<span class="btn-arrow" aria-hidden="true">→</span>
				</a>
			</div>

			<dl class="final-cta-contact">
				<div>
					<dt>WhatsApp</dt>
					<dd><a href={whatsapp}>+62 897 7200 741</a></dd>
				</div>
				<div>
					<dt>Booth</dt>
					<dd>{copy.booth[0]}<br />{copy.booth[1]}</dd>
				</div>
			</dl>
		</div>
	</div>
</section>

<style>
	/* The closing spread: one statement at full scale, then the action and
	   the practical details on a single hairline, like a last page. */
	.final-cta {
		padding-block: clamp(1rem, 2vw, 2rem) clamp(3rem, 5vw, 4.5rem);
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}

	.final-cta-inner h2 {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		font-size: clamp(3rem, 8.6vw, 8.5rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.final-cta-foot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		column-gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
		margin-top: clamp(2rem, 4vw, 3.5rem);
		padding-top: clamp(1.75rem, 3vw, 2.5rem);
		border-top: 1px solid var(--color-border);
	}

	.final-cta-sub {
		margin-bottom: 1.5rem;
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.final-cta-contact {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 2.5rem;
		justify-self: end;
	}

	.final-cta-contact dt {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin-bottom: 0.5rem;
	}

	.final-cta-contact dd {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-ink-muted);
	}

	.final-cta-contact a {
		border-bottom: 1px solid var(--color-border);
		transition: border-color 0.2s ease;
	}

	.final-cta-contact a:hover,
	.final-cta-contact a:focus-visible {
		border-color: var(--color-ink);
	}

	@media (max-width: 799px) {
		.final-cta-foot {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}

		.final-cta-contact {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			justify-self: start;
		}
	}
</style>
